{
  "name": "careloop",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:db": "docker compose run --rm -v \"$PWD/server:/app/server\" -e 'DATABASE_URL=postgresql://careloop:careloop_local_only@db:5432/careloop_test?schema=public' server npm run test:db",
    "seed": "docker compose run --rm -v \"$PWD/server:/app/server\" server npm run seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
