{
  "name": "@careloop/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "test:db": "npm run generate && node scripts/reset-test-db.mjs && prisma migrate deploy && tsx --test --test-concurrency=1 \"src/**/*.test.ts\" \"tests/*.db.ts\"",
    "seed": "npm run generate && prisma migrate deploy && tsx src/seed.ts",
    "seed:demo": "tsx src/demoSeed.ts",
    "demo:reset": "node scripts/demo-reset.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@careloop/shared": "*",
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "tsx": "^4.19.4"
  }
}
